/* rsxkit — vertex program de las pasadas de posprocesado: la posición ya
 * en espacio de recorte, TEXCOORD0 por vértice y las constantes del dibujo
 * (TEXCOORD1..7, atributos iguales en los cuatro vértices) copiadas a la
 * salida. */
void main(float4 position : POSITION, float4 t0 : TEXCOORD0, float4 t1 : TEXCOORD1, float4 t2 : TEXCOORD2,
	  float4 t3 : TEXCOORD3, float4 t4 : TEXCOORD4, float4 t5 : TEXCOORD5, float4 t6 : TEXCOORD6,
	  float4 t7 : TEXCOORD7, out float4 oPosition : POSITION, out float4 o0 : TEXCOORD0,
	  out float4 o1 : TEXCOORD1, out float4 o2 : TEXCOORD2, out float4 o3 : TEXCOORD3, out float4 o4 : TEXCOORD4,
	  out float4 o5 : TEXCOORD5, out float4 o6 : TEXCOORD6, out float4 o7 : TEXCOORD7)
{
	oPosition = position;
	o0 = t0;
	o1 = t1;
	o2 = t2;
	o3 = t3;
	o4 = t4;
	o5 = t5;
	o6 = t6;
	o7 = t7;
}
