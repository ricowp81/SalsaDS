/* rsxkit — combinación lineal con dos texturas:
 * T0·X0 + T0.aaaa·X1 + T1·X2 + T1.aaaa·X3 + X4. */
void main(float4 uv : TEXCOORD0, float4 x0 : TEXCOORD1, float4 x1 : TEXCOORD2, float4 x2 : TEXCOORD3,
	float4 x3 : TEXCOORD4, float4 x4 : TEXCOORD5,
	uniform sampler2D tex0 : TEXUNIT0, uniform sampler2D tex1 : TEXUNIT1, out float4 color : COLOR)
{
	float4 t0 = tex2D(tex0, uv.xy);
	float4 t1 = tex2D(tex1, uv.zw);
	color = saturate(t0 * x0 + t0.aaaa * x1 + t1 * x2 + t1.aaaa * x3 + x4);
}
