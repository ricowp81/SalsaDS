/* Dos límites inclusivos para la puerta de profundidad DS. */
#include "wdepth.cgi"
void main(float4 pos : WPOS, float4 q : TEXCOORD2, float4 s : TEXCOORD5,
          out float depth : DEPTH, out float4 result : COLOR)
{
#ifdef RSX3D_W
    float d = RSX3D_WDEPTH(pos, q, s);
#else
    float d = pos.z;
#endif
    depth = clamp(d + q.z, 0.0, 1.0);
    result = float4(0.0, 0.0, 0.0, 0.0);
}
