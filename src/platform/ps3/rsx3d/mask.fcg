#include "wdepth.cgi"
void main(float4 q : TEXCOORD2,
#ifdef RSX3D_W
          float4 pos : WPOS, float4 s : TEXCOORD5, out float depth : DEPTH,
#endif
          out float4 result : COLOR)
{
#ifdef RSX3D_W
    depth = RSX3D_WDEPTH(pos, q, s);
#endif
    result = float4(0.0, 0.0, 0.0, 0.0);
}
